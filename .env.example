MONGODB_URI=mongodb+srv://USER:PASSWORD@HOST/habitee?retryWrites=true&w=majority
APP_BASE_URL=http://localhost:3000

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@example.com
SMTP_PASS=your-smtp-app-password
